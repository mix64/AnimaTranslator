# このファイルを .env にコピーして、自分の環境の値を書く。.env は git に入れない。
# ここの値は既定値として使われる。設定画面で保存した値があれば、そちらが優先される。

# API キー。設定画面で保存したキーが空のときに使う。
DEEPSEEK_API_KEY=
# OpenCode Go のキー（https://opencode.ai/console で発行）
OPENCODE_API_KEY=

# ローカル LLM（OpenAI 互換 API）のベース URL。/v1 まで書く。
ANIMA_LOCAL_URL=http://localhost:8000/v1

# Danbooru MCP の URL。空ならローカルのタグ表（tags/danbooru.csv）だけで照合する。
ANIMA_MCP_URL=
